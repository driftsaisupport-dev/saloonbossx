<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup rules.

  Android silently uploads this to the user's own Google Drive (it does not
  count against their quota) and restores it when they set up a new phone.
  No API key, no OAuth, no Google Cloud project, no cost, no upkeep.

  Only the JSON export folder is included. The SQLCipher database and SecureStore
  are excluded by omission, so neither is transferred to another device.

  Copy into android/app/src/main/res/xml/ after `npx expo prebuild`, and
  reference it from AndroidManifest.xml:
      android:allowBackup="true"
      android:fullBackupContent="@xml/backup_rules"
      android:dataExtractionRules="@xml/data_extraction_rules"
-->
<full-backup-content>
  <include domain="file" path="backups/" />
</full-backup-content>
