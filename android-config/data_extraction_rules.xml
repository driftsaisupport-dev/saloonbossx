<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ equivalent of backup_rules.xml. Both are required. -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="file" path="backups/" />
  </cloud-backup>
  <device-transfer>
    <include domain="file" path="backups/" />
  </device-transfer>
</data-extraction-rules>
